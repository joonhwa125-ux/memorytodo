# 기억(Memory) — 환경 변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채워주세요.
# .env.local 은 .gitignore 되어 git 에 올라가지 않습니다.

# ────────────────────────────────────────────────────────────
# Backend — MongoDB connection (Atlas 또는 로컬)
# ────────────────────────────────────────────────────────────
# 로컬 MongoDB:
#   MONGO_URI=mongodb://localhost:27017/halilapp
#
# MongoDB Atlas (배포용):
#   Atlas Connect → Drivers (Node.js) 에서 string 복사 후
#     - <db_password> 부분을 실제 비밀번호로 교체
#     - .mongodb.net/ 와 ? 사이에 halilapp 추가
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/halilapp?retryWrites=true&w=majority

# ────────────────────────────────────────────────────────────
# Backend — CORS allowed origins (optional, 쉼표 구분)
# localhost 는 항상 허용. 프로덕션 프론트 도메인을 추가하세요.
# ────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://memory.vercel.app,https://memory-staging.vercel.app

# ────────────────────────────────────────────────────────────
# Frontend → Backend
# 로컬: http://localhost:5000 (기본값)
# 프로덕션: Render 배포 URL
# ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
